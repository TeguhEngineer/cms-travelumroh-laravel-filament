########################################################################
# Asella CMS — template .env untuk PRODUCTION
#
# Salin file ini ke `.env` di server, lalu isi semua nilai bertanda TODO.
#   cp deploy/env.production.example .env
#   php artisan key:generate
########################################################################

APP_NAME="ASELLA TRAVEL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# TODO: ganti dengan domain/IP publik VPS Anda (WAJIB https, bukan http).
# Frontend Netlify memanggil URL ini, dan browser memblokir request http
# dari halaman https (mixed content).
APP_URL=https://cms.example.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ---------------------------------------------------------------------
# CORS — origin frontend yang boleh memanggil /api/*
# Tambahkan domain custom di sini bila nanti dipasang (pisahkan koma).
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="https://travelumroh-v1.netlify.app"

# Batas request API per menit per IP.
API_RATE_LIMIT=120

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asella_cms
DB_USERNAME=asella
DB_PASSWORD=

# ---------------------------------------------------------------------
# Session & cache
# ---------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true karena situs diakses lewat HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------
# Filesystem
# ---------------------------------------------------------------------
# WAJIB "public". Default Laravel adalah "local" (storage/app/private),
# dan upload gambar dari Filament akan tersimpan di folder yang tidak
# bisa diakses browser -> gambar 404 di frontend.
FILESYSTEM_DISK=public

# ---------------------------------------------------------------------
# Mail (opsional — dipakai untuk reset password Filament)
# ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------
# Nginx berjalan di mesin yang sama dengan PHP-FPM, jadi cukup 127.0.0.1.
# Isi "*" bila memakai Cloudflare / load balancer di depan VPS.
TRUSTED_PROXIES=127.0.0.1
